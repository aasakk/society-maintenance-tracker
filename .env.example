# Environment variables for local development

# PostgreSQL database connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/society_tracker?schema=public"

# NextAuth Secret (generate a random string)
NEXTAUTH_SECRET="my-super-secret-random-string"

# NextAuth URL (base URL of your app)
NEXTAUTH_URL="http://localhost:3000"

# Optional: Cloudinary/Supabase API keys for real photo uploads
# CLOUDINARY_URL="cloudinary://..."

# Optional: Resend API key for real email notifications
# RESEND_API_KEY="re_..."
